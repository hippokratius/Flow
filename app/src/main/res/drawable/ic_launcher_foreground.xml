<!--
    TubeHub launcher glyph — a placeholder, not a designed identity.

    Upstream Flow's mark (a red YouTube-shaped plate with a stylised "F") is deliberately not used:
    forking GPL code grants no rights to the project's trademark, and shipping someone else's mark
    under a different name would misrepresent both.

    Carries its own plate because this drawable is shared by launcher variants whose backgrounds
    range from near-black to white, so it cannot borrow contrast from the background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">
        <path
            android:fillColor="@color/ic_launcher_plate"
            android:pathData="M6,3 L18,3 A3,3 0 0 1 21,6 L21,18 A3,3 0 0 1 18,21 L6,21 A3,3 0 0 1 3,18 L3,6 A3,3 0 0 1 6,3 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10,8 L16.5,12 L10,16 Z" />
    </group>
</vector>

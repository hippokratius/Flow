<!--
    Silhouette form of the launcher glyph.

    Used two ways: as the foreground of the Material You variant, and as the <monochrome> layer of
    every variant. Themed icons re-tint this layer wholesale, so it must be one solid shape with no
    internal colour — a plate here would swallow the glyph once tinted.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="2.5"
        android:scaleY="2.5"
        android:translateX="24"
        android:translateY="24">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M8,5.5 L18.5,12 L8,18.5 Z" />
    </group>
</vector>

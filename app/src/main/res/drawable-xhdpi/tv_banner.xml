<?xml version="1.0" encoding="utf-8"?>
<!--
    Android TV launcher banner.

    Carries the same plate-and-play-glyph mark as res/drawable/ic_launcher_foreground.xml and the
    home screen header, rather than upstream Flow's red YouTube-shaped badge with a white "F".

    Geometry: the mark is 18x18 inside a 24x24 space, scaled 7x to 126x126 and centred on the
    320x180 canvas (x 97-223, y 27-153). That stays well inside the 5% overscan-safe area
    (x 16-304, y 9-171), which is what the translate values are for.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="90dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M0,0h320v180h-320z" />
    <group
        android:scaleX="7"
        android:scaleY="7"
        android:translateX="76"
        android:translateY="6">
        <path
            android:fillColor="@color/ic_launcher_plate"
            android:pathData="M6,3 L18,3 A3,3 0 0 1 21,6 L21,18 A3,3 0 0 1 18,21 L6,21 A3,3 0 0 1 3,18 L3,6 A3,3 0 0 1 6,3 Z" />
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M10,8 L16.5,12 L10,16 Z" />
    </group>
</vector>
